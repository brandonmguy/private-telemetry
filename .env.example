# npm start loads .env automatically. Compose also reads this file when named .env.
# Native Node binds the viewer locally; Compose binds inside its container.
API_HOST=127.0.0.1
RECV_HOST=127.0.0.1
API_PORT=3000
RECV_PORT=3001
# DB_PATH=./server/telemetry.db

# Docker host bindings. Use a specific LAN IP for the receiver only if needed.
UI_BIND=127.0.0.1
RECEIVER_BIND=127.0.0.1
HTTP_RECV_PORT=3001
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
# Only enable this for a known reverse proxy; see README for syntax.
# TRUST_PROXY=loopback
# Optional prebuilt release image; otherwise Compose builds locally.
# TELEMETRY_IMAGE=ghcr.io/brandonmguy/private-telemetry:v1.1.0
